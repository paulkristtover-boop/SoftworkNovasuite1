{
  "name": "softwork-nova-suite",
  "version": "2.2.0",
  "private": true,
  "description": "SoftworkNovaSuite PTC — Telegraf bot (users + admin notifications) + Next.js Admin CMS",
  "scripts": {
    "migrate": "node shared/database/migrate.js",
    "seed": "node shared/database/seed.js",
    "bot": "node user-bot/bot.js",
    "start": "node user-bot/bot.js",
    "cms:dev": "cd admin-cms && npm run dev",
    "cms:build": "cd admin-cms && npm run build",
    "cms:install": "cd admin-cms && npm install"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "telegraf": "^4.16.3",
    "pg": "^8.13.1",
    "dotenv": "^16.4.5",
    "uuid": "^10.0.0",
    "node-cron": "^3.0.3",
    "express": "^4.21.0",
    "winston": "^3.14.2",
    "dayjs": "^1.11.13"
  }
}
