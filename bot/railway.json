{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install --omit=dev && cd ../database && npm install --omit=dev"
  },
  "deploy": {
    "startCommand": "cd ../database && node migrate.js && cd ../bot && node bot.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
