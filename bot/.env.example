# ============================================================
# NovaSuite Bot – Railway environment variables
# ============================================================

# Required
BOT_TOKEN=
ADMIN_IDS=123456789,987654321
DATABASE_URL=postgresql://user:password@host:5432/novasuite
ADMIN_CMS_URL=https://YOUR.vercel.app
NODE_ENV=production

# Webhook (production)
USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_PATH=/webhook/telegram
BOT_PORT=3001
PORT=3001

# USDT economics
CURRENCY=USDT
CURRENCY_SYMBOL=$
MIN_WITHDRAW=5
MIN_DEPOSIT=1
REFERRAL_BONUS_PERCENT=10
DEFAULT_AD_REWARD=0.01
MAX_ADS_PER_USER=20
AD_VIEW_COOLDOWN_SECONDS=30

# Anti-abuse
RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX_HITS=8
BAN_MESSAGE=Your account has been banned. Contact support if this is a mistake.

# Support & legal
SUPPORT_USERNAME=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
PLATFORM_NAME=NovaSuite

# Trust wallet defaults
TRUST_WALLET_ADDRESS=
DEFAULT_NETWORK=TRC20

LOG_LEVEL=info
