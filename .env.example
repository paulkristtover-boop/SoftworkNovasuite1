# ============================================================
# NovaSuite – FULL PRODUCTION ENVIRONMENT
# Copy to .env for local, or set in Railway / Vercel dashboards
# ============================================================

# ────────────────────────────────────────────────────────────
# RAILWAY (Telegram Bot – Telegraf)
# Required
# ────────────────────────────────────────────────────────────
BOT_TOKEN=
ADMIN_IDS=
DATABASE_URL=
ADMIN_CMS_URL=https://YOUR.vercel.app
NODE_ENV=production

# Webhook (recommended in production; polling is fine for small traffic)
USE_WEBHOOK=false
WEBHOOK_URL=https://your-bot.up.railway.app
WEBHOOK_PATH=/webhook/telegram
BOT_PORT=3001
PORT=3001

# Platform economics (USDT only – no Naira)
CURRENCY=USDT
CURRENCY_SYMBOL=$
MIN_WITHDRAW=5
MIN_DEPOSIT=1
REFERRAL_BONUS_PERCENT=10
DEFAULT_AD_REWARD=0.01
MAX_ADS_PER_USER=20
AD_VIEW_COOLDOWN_SECONDS=30

# Rate limiting / anti-abuse
RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX_HITS=8
BAN_MESSAGE=Your account has been banned. Contact support if this is a mistake.

# Support & legal (shown in bot; also editable in CMS settings)
SUPPORT_USERNAME=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
PLATFORM_NAME=NovaSuite

# Trust wallet defaults (override anytime in CMS → Treasury / Addresses)
TRUST_WALLET_ADDRESS=
DEFAULT_NETWORK=TRC20

# Logging
LOG_LEVEL=info

# ────────────────────────────────────────────────────────────
# VERCEL (Admin CMS – Next.js)
# Set these in Vercel → Project → Settings → Environment Variables
# Use the SAME DATABASE_URL as Railway
# ────────────────────────────────────────────────────────────
# DATABASE_URL=
# ADMIN_CMS_PASSWORD=
# ADMIN_CMS_SECRET=
# BOT_TOKEN=
# ADMIN_CMS_USERNAME=admin
# NEXT_PUBLIC_PLATFORM_NAME=NovaSuite
# NEXT_PUBLIC_CURRENCY=USDT
# NODE_ENV=production

# Optional: allow CMS to notify admins via Telegram after approve/reject
# TELEGRAM_NOTIFY_ON_CMS_ACTION=true
