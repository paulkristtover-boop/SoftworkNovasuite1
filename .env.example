# ═══════════════════════════════════════════
# SoftworkNovaSuite
# 1) Telegraf bot  2) Next.js Admin CMS
# ═══════════════════════════════════════════

# --- Telegram bot (Telegraf) ---
# One bot: users + admin notifications
BOT_TOKEN=123456:AA...from_BotFather
ADMIN_IDS=123456789

# --- PostgreSQL (shared by bot + CMS) ---
DATABASE_URL=postgresql://user:password@host:5432/softwork_nova_suite

# --- Next.js Admin CMS (Vercel) ---
ADMIN_CMS_PASSWORD=change-me-strong-password
ADMIN_CMS_SECRET=long-random-session-secret
ADMIN_CMS_URL=https://your-cms.vercel.app

# --- App ---
CURRENCY=USDT
MIN_DEPOSIT=5
MIN_WITHDRAWAL=10
SUPPORT_USERNAME=@YourSupport
SUPPORT_EMAIL=support@example.com
TRUST_WALLET_LABEL=SoftworkNovaSuite Trust Wallet
NODE_ENV=production

# PTC defaults (also editable in CMS Settings)
PTC_DEFAULT_REWARD=0.001
PTC_MIN_BUDGET=1
PTC_MIN_REWARD=0.0005
PTC_MAX_REWARD=0.05

# Optional webhook for bot host
USE_WEBHOOK=false
WEBHOOK_DOMAIN=
WEBHOOK_PATH=/telegram-webhook
PORT=3000
