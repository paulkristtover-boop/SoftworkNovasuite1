# ═══ Railway (Bot) ═══
BOT_TOKEN=
ADMIN_IDS=
DATABASE_URL=
ADMIN_CMS_URL=https://YOUR.vercel.app
NODE_ENV=production

USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_PATH=/webhook/telegram
PORT=3001

# Currency & limits
CURRENCY=USDT
CURRENCY_SYMBOL=$
MIN_WITHDRAW=5
MIN_DEPOSIT=1
DEFAULT_NETWORK=TRC20
TRUST_WALLET_ADDRESS=

# Tax / treasury (platform revenue) — percent of amount
# Deposit: user sends X, credit = X * (1 - DEPOSIT_TAX/100), tax → treasury
DEPOSIT_TAX_PERCENT=0
# Withdraw: user requests X from balance; net paid ≈ X * (1 - WITHDRAW_TAX/100)
WITHDRAW_TAX_PERCENT=0
PLATFORM_TAX_PERCENT=0

# Automatic deposit verification (on-chain explorers)
# When true: submit TxID → bot verifies amount/address → auto-credits if OK
AUTO_DEPOSIT_ENABLED=true
AUTO_DEPOSIT_FALLBACK_PENDING=true
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
MIN_CONF_TRC20=1
MIN_CONF_ERC20=3
MIN_CONF_BEP20=3
DEPOSIT_POLL_MINUTES=5

# Campaigns / Earn / Advertise
REFERRAL_BONUS_PERCENT=10
DEFAULT_AD_REWARD=0.01
MIN_AD_REWARD=0.005
MAX_AD_REWARD=1
MAX_ADS_PER_USER=20
AD_VIEW_DURATION_SEC=15
AD_VIEW_COOLDOWN_SEC=60
MAX_DAILY_AD_VIEWS=50
MAX_DAILY_EARN=10
AD_PLATFORM_FEE_PERCENT=5
# Anti-idle: user must open ad link before "I completed"
REQUIRE_LINK_OPEN=true
# Refund unused budget when admin rejects a campaign
REFUND_ON_REJECT=true
# Also refund the platform fee on reject (default false = fee kept for review cost)
REFUND_FEE_ON_REJECT=false

# Welcome & community
WELCOME_BONUS_AMOUNT=0.5
WELCOME_BONUS_LIMIT=30
CHANNEL_URL=https://t.me/SoftworkNovaSuite
GROUP_URL=https://t.me/softworknovasuitecommunity
CHANNEL_USERNAME=@SoftworkNovaSuite
GROUP_USERNAME=@softworknovasuitecommunity
REQUIRE_MEMBERSHIP=true
STRICT_MEMBERSHIP=false

# Rate limit / session
RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX=8
SESSION_TTL_HOURS=24

# Branding / legal
PLATFORM_NAME=NovaSuite
SUPPORT_USERNAME=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
LOG_LEVEL=info
BACKUP_DIR=./backups

# ═══ Vercel (admin-cms) – Root Directory = admin-cms ═══
