# ═══════════════════════════════════════════════════════════
# NovaSuite – environment template
# Copy to .env for local use. On deploy, set vars in Railway / Vercel.
# ═══════════════════════════════════════════════════════════

# ── Shared ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/novasuite
NODE_ENV=production
BOT_TOKEN=

# ── Railway (bot) ─────────────────────────────────────────
ADMIN_IDS=
ADMIN_CMS_URL=https://YOUR.vercel.app

USE_WEBHOOK=false
WEBHOOK_URL=
WEBHOOK_PATH=/webhook/telegram
BOT_PORT=3001
PORT=3001

CURRENCY=USDT
CURRENCY_SYMBOL=$
MIN_WITHDRAW=5
MIN_DEPOSIT=1
REFERRAL_BONUS_PERCENT=10
DEFAULT_AD_REWARD=0.01
MAX_ADS_PER_USER=20
AD_VIEW_COOLDOWN_SECONDS=30

RATE_LIMIT_WINDOW_MS=3000
RATE_LIMIT_MAX_HITS=8
BAN_MESSAGE=Your account has been banned. Contact support if this is a mistake.

PLATFORM_NAME=NovaSuite
SUPPORT_USERNAME=
SUPPORT_EMAIL=
TERMS_URL=
PRIVACY_URL=
TRUST_WALLET_ADDRESS=
DEFAULT_NETWORK=TRC20
LOG_LEVEL=info

# ── Vercel (cms) – set in Vercel dashboard ────────────────
# DATABASE_URL=          (same as above)
# ADMIN_CMS_PASSWORD=
# ADMIN_CMS_SECRET=
# BOT_TOKEN=
# ADMIN_CMS_USERNAME=admin
# NEXT_PUBLIC_PLATFORM_NAME=NovaSuite
# NODE_ENV=production
