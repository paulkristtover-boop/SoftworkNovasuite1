# ============================================================
# NovaSuite Admin CMS – Vercel environment variables
# ============================================================

# Required – same Postgres as the Railway bot
DATABASE_URL=postgresql://user:password@host:5432/novasuite

# CMS login password (single admin password)
ADMIN_CMS_PASSWORD=change_me_to_a_strong_password

# JWT / session secret (long random string, min 32 chars)
ADMIN_CMS_SECRET=generate_a_long_random_secret_at_least_32_chars

# Telegram bot token (optional – used if CMS sends user notifications)
BOT_TOKEN=

# Optional display / branding
ADMIN_CMS_USERNAME=admin
NEXT_PUBLIC_PLATFORM_NAME=NovaSuite
NEXT_PUBLIC_CURRENCY=USDT
NODE_ENV=production

# Optional: when true, CMS can call Telegram API after approve/reject
TELEGRAM_NOTIFY_ON_CMS_ACTION=true
